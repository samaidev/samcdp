<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.samaidev.samcdp"
    android:versionCode="33"
    android:versionName="1.4.6">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- runner processes launch TabActivity from a background service; the overlay
         permission is the standard Android 10+ / ColorOS background-activity-start
         exemption that makes the "显示WebView" handover actually come to front -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CdpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Full-screen WebView host (human handover) — one per runner process -->
        <activity android:name=".TabActivity1" android:exported="false" android:process=":cdp1" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <activity android:name=".TabActivity2" android:exported="false" android:process=":cdp2" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <activity android:name=".TabActivity3" android:exported="false" android:process=":cdp3" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <activity android:name=".TabActivity4" android:exported="false" android:process=":cdp4" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <activity android:name=".TabActivity5" android:exported="false" android:process=":cdp5" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />
        <activity android:name=".TabActivity6" android:exported="false" android:process=":cdp6" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <!-- One dedicated process per profile = isolated WebView data dir + cookie jar -->
        <service android:name=".RunnerService1" android:exported="false" android:process=":cdp1" android:foregroundServiceType="dataSync" />
        <service android:name=".RunnerService2" android:exported="false" android:process=":cdp2" android:foregroundServiceType="dataSync" />
        <service android:name=".RunnerService3" android:exported="false" android:process=":cdp3" android:foregroundServiceType="dataSync" />
        <service android:name=".RunnerService4" android:exported="false" android:process=":cdp4" android:foregroundServiceType="dataSync" />
        <service android:name=".RunnerService5" android:exported="false" android:process=":cdp5" android:foregroundServiceType="dataSync" />
        <service android:name=".RunnerService6" android:exported="false" android:process=":cdp6" android:foregroundServiceType="dataSync" />
        <!-- v1.4.2: serves WebView-downloaded files over content:// for
             ACTION_VIEW opens (phone ⬇ list) and onShowFileChooser uploads.
             Not exported — access granted per-intent via grantUriPermissions. -->
        <provider
            android:name=".DownloadsProvider"
            android:authorities="cc.samaidev.samcdp.downloads"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
